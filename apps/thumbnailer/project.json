{
  "name": "thumbnailer",
  "sourceRoot": "apps/thumbnailer/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "npm run build:thumbnailer" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "npm run dev:thumbnailer" }
    }
  }
}
