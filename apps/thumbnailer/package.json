{
  "name": "thumbnailer",
  "version": "0.0.1",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "functions-framework --target=thumbnailer",
    "deploy": "gcloud functions deploy thumbnailer --gen2 --region=europe-north1 --allow-unauthenticated --runtime=nodejs22 --source=. --entry-point=thumbnailer --trigger-http",
    "build:watch": "tsc -w"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.2",
    "dotenv": "^16.4.5",
    "fastq": "^1.17.1",
    "puppeteer": "^23.9.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "typescript": "^5.0.0"
  }
}
