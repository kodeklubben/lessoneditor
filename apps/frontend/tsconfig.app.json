{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "outDir": "../../dist/out-tsc",
    "types": ["node"],
    "incremental": false
  },
  "files": ["src/assets.d.ts"],
  "exclude": ["**/*.spec.ts", "**/*.spec.tsx", "jest.config.cjs"],
  "include": [
    "**/*.js",
    "**/*.jsx",
    "**/*.ts",
    "**/*.tsx",
    "src/**/*.ts",
    "../../libs/contracts/src/**/*.ts"
  ]
}
