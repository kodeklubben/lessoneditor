# Create a GitHub OAuth app with homepage http://localhost:4200 and
# callback http://localhost:4200/api/auth/callback. These must match exactly.
GH_CLIENT_ID=replace-with-local-oauth-client-id
GH_CLIENT_SECRET=replace-with-local-oauth-client-secret
GH_CALLBACK_URL=http://localhost:4200/api/auth/callback
GH_LESSON_REPO_OWNER=kodeklubben
GH_LESSON_REPO=oppgaver

FRONTEND_URL=http://localhost:4200
THUMB_SERVICE_URL=http://localhost:3012
NODE_ENV=development

# Generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace-with-random-cookie-secret
SESSION_SECRET=replace-with-random-session-secret

# Disables the entire GitHub submission, including forks and commits.
DISABLE_PULL_REQUESTS=true

POSTGRES_USER=lessoneditor
POSTGRES_PASSWORD=lessoneditor-local-only
POSTGRES_DB=lessoneditor
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_SYNCHRONIZE=false
POSTGRES_ENTITIES=dist/apps/backend/**/*.entity.js
POSTGRES_MIGRATIONS=dist/apps/backend/db/migrations/*.js
