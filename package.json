{
  "name": "lessoneditor",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <13"
  },
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:backend && npm run build:thumbnailer && concurrently --kill-others --names backend,frontend,thumbnailer \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:thumbnailer\"",
    "dev:backend": "concurrently --kill-others \"tsc -p apps/backend/tsconfig.app.json --watch --preserveWatchOutput\" \"node --watch dist/apps/backend/apps/backend/src/main.js\"",
    "dev:frontend": "nx serve frontend",
    "dev:thumbnailer": "node --env-file=.env node_modules/@google-cloud/functions-framework/build/src/main.js --source=apps/thumbnailer --target=thumbnailer --port=3012",
    "start:dev": "npm run dev",
    "start": "node dist/apps/backend/apps/backend/src/main.js",
    "build": "nx run-many --target=build --all",
    "build:all": "npm run build",
    "build:dev": "npm run build",
    "build:backend": "tsc -p apps/backend/tsconfig.app.json",
    "build:frontend": "nx build frontend",
    "build:thumbnailer": "npm run build --workspace=thumbnailer",
    "typecheck": "tsc -p apps/backend/tsconfig.app.json --noEmit && tsc -p apps/frontend/tsconfig.app.json --noEmit && tsc -p apps/thumbnailer/tsconfig.json --noEmit",
    "lint": "eslint apps/backend/src apps/frontend/src/app apps/frontend/src/main.tsx apps/thumbnailer/src libs db --max-warnings=0",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test-all": "npm test",
    "test-backend": "npm test -- --selectProjects backend",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "migration:run": "npm run build:backend && npm run typeorm -- migration:run",
    "migration:show": "npm run build:backend && npm run typeorm -- migration:show",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:revert": "npm run typeorm -- migration:revert",
    "typeorm": "typeorm -d dist/apps/backend/db/data-sources.js",
    "nx": "nx",
    "format:check": "prettier --check",
    "format:write": "prettier --write",
    "test:smoke": "node tools/smoke.cjs",
    "gcp-build": "npm run build:backend && npm run build:frontend",
    "browser:install": "puppeteer browsers install chrome"
  },
  "private": true,
  "dependencies": {
    "@nestjs/axios": "12.0.1",
    "@nestjs/cache-manager": "12.0.1",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/serve-static": "12.0.0",
    "@nestjs/typeorm": "12.0.2",
    "@octokit/openapi-types": "29.0.1",
    "@octokit/rest": "22.0.1",
    "axios": "1.20.0",
    "blob-util": "2.0.2",
    "cache-manager": "7.2.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compressorjs": "1.4.0",
    "cookie-parser": "1.4.7",
    "core-js": "3.50.0",
    "crypto-js": "4.2.0",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "fast-equals": "6.1.1",
    "highlight.js": "11.12.0",
    "js-yaml": "4.3.2",
    "jsonwebtoken": "9.0.3",
    "keyv": "6.1.0",
    "lodash.debounce": "4.0.8",
    "markdown-it": "15.0.2",
    "markdown-it-attrs": "5.0.1",
    "markdown-it-container": "4.0.0",
    "markdown-it-emoji": "3.1.0",
    "passport": "0.7.0",
    "passport-oauth2": "1.8.0",
    "pg": "8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hotkeys-hook": "5.3.3",
    "react-router": "7.18.4",
    "react-router-dom": "7.18.4",
    "reflect-metadata": "0.2.2",
    "regenerator-runtime": "0.14.1",
    "rxjs": "7.8.2",
    "scratchblocks": "3.7.1",
    "semantic-ui-css": "2.5.0",
    "semantic-ui-react": "3.0.0-beta.2",
    "slugify": "1.6.9",
    "tslib": "2.8.1",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/jest": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/webpack": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/cookie-parser": "1.4.10",
    "@types/crypto-js": "4.2.2",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash.debounce": "4.0.9",
    "@types/markdown-it-container": "4.0.1",
    "@types/markdown-it-emoji": "3.0.1",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.1",
    "@types/passport": "1.0.17",
    "@types/passport-oauth2": "1.8.0",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "babel-jest": "30.5.2",
    "concurrently": "10.0.6",
    "css-loader": "7.1.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "nx": "23.3.0",
    "prettier": "3.9.9",
    "sass": "1.105.1",
    "sass-loader": "17.0.1",
    "style-loader": "4.0.0",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "5.2.6"
  },
  "workspaces": [
    "apps/thumbnailer"
  ],
  "overrides": {
    "undici": "^7.30.0",
    "cloudevents": {
      "uuid": "^11.1.1"
    },
    "sockjs": {
      "uuid": "^11.1.1"
    }
  }
}
